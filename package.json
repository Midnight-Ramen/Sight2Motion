{
  "name": "ai-vision-robot-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:model": "node scripts/download-model.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@teachablemachine/image": "0.8.5",
    "@tensorflow/tfjs": "4.22.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@teachablemachine/image": {
      "@tensorflow/tfjs": "$@tensorflow/tfjs"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
